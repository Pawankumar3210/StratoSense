# --- Backend (copy to backend/.env for local development) ---------------------------------
APP_ENV=development
MODEL_PATH=artifacts/checkpoints/stratosense_unet.pth
MODEL_VERSION=1.0.0
MODEL_DEVICE=auto
MODEL_ARTIFACT_URL=
MODEL_SHA256=
MAX_UPLOAD_MB=50
# Comma-separated exact origins. Production must list the real frontend origin (no '*').
CORS_ORIGINS=http://localhost:5173

# --- ML / notebooks ----------------------------------------------------------------------
# Folder containing the extracted 38-Cloud_training and 38-Cloud_test directories.
STRATOSENSE_DATA_ROOT=

